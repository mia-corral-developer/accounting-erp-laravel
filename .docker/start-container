#!/usr/bin/env sh
set -e

# Runs migrations/optimization once, then starts the requested process.
# The web container execs php-fpm (no supervisord, no Octane/RoadRunner).
container_mode=${CONTAINER_MODE:-"http"}
running_migrations_and_seeders=${RUNNING_MIGRATIONS_AND_SEEDERS:-"false"}

run_as() {
    su-exec "${USER:-octane}" "$@"
}

initialStuff() {
    echo "Container mode: $container_mode"

    if [ "${running_migrations_and_seeders}" = "true" ]; then
        echo "Running migrations and seeding database ..."
        # Single, isolated attempt. Never fall back to a second bare `migrate`:
        # if the first run fails half-way, re-running it over a partially
        # migrated database only produces misleading "table already exists"
        # errors. Fail loudly instead so the platform can retry cleanly.
        run_as php artisan migrate --isolated --seed --force
    fi

    run_as php artisan storage:link || true
    run_as php artisan optimize
    # Compile the module registry at boot so request-time resolution reads one
    # cache file instead of re-scanning every module's composer.json.
    run_as php artisan module:cache || true
}

if [ "$1" != "" ]; then
    exec "$@"
elif [ "${container_mode}" = "http" ]; then
    initialStuff
    echo "Starting PHP-FPM ..."
    # Master stays root (to setuid the pool user); workers run as 'octane'.
    exec php-fpm -F
elif [ "${container_mode}" = "worker" ]; then
    if [ -z "${WORKER_COMMAND}" ]; then
        echo "WORKER_COMMAND is undefined."
        exit 1
    fi
    initialStuff
    exec run_as sh -c "${WORKER_COMMAND}"
elif [ "${container_mode}" = "scheduler" ]; then
    initialStuff
    exec run_as supercronic -overlapping /etc/supercronic/laravel
elif [ "${container_mode}" = "horizon" ]; then
    initialStuff
    exec run_as php artisan horizon
elif [ "${container_mode}" = "reverb" ]; then
    initialStuff
    exec run_as php artisan reverb:start
else
    echo "Container mode mismatched."
    exit 1
fi